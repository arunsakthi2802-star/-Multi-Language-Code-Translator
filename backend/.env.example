ENV=development
SECRET_KEY=change-this-in-production-secure-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./translator.db

# Primary AI Provider: 'gemini', 'openai', 'ollama', or 'rule_based'
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-Compatible Fallback / Alternative
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

REQUEST_TIMEOUT_SECONDS=45
MAX_SOURCE_CODE_SIZE_BYTES=100000

# Sandbox execution (requires Docker)
ENABLE_SANDBOX=false
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MEMORY_LIMIT_MB=128
